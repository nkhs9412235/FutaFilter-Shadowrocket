#!name=FutaFilter Shadowrocket 2026
#!desc=FutaFilter for Shadowrocket — optimized 2026 edition
#!system=ios

[Rule]

# ============================================================
# FutaFilter Shadowrocket 2026
#
# Based on:
# - FutaFilter v20231207.01
# - jkgtw LINE-ADs v20260904.02
#
# Optimized for Shadowrocket
# Updated: 2026-09-04
# ============================================================


# ============================================================
# LINE
# ============================================================


# ------------------------------------------------------------
# LINE whitelist
# ------------------------------------------------------------

# LINE resource path used by normal content.
# Keep this before other LINE URL rules.
URL-REGEX,^https:\/\/obs\.line-scdn\.net\/r,DIRECT

# LINE Sticker Shop
DOMAIN,stickershop.line-scdn.net,DIRECT


# ------------------------------------------------------------
# LINE Ads / Smart Channel
# ------------------------------------------------------------

# LINE Ads impression / event pixels

URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/er\/lads\/v\d+\/ei(?:\?|$),REJECT-TINYGIF
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/er\/(?:lass|ladg|lads)\/v\d+\/event\/image(?:\?|$),REJECT-TINYGIF


# LINE Ads APIs

URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/lass\/api\/v\d+\/ads(?:\?|$),REJECT
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/oa\/v\d+\/e(?:\?|$),REJECT
URL-REGEX,^https:\/\/a\.line\.me(?::443)?\/cs\/v\d+\/oa(?:\?|$),REJECT


# Legacy / compatibility LINE Ads gateways

URL-REGEX,^https:\/\/gw\.line\.naver\.jp(?::443)?\/ext\/lgfp\/lad\/v\d+(?:\?|$),REJECT
URL-REGEX,^https:\/\/gw\.line\.naver\.jp(?::443)?\/lass\/api\/v\d+\/ads(?:\?|$),REJECT


# Current LINE Ads / Smart Channel

URL-REGEX,^https:\/\/legy\.line-apps\.com(?::443)?\/ext\/lgfp\/lad\/v\d+(?:\?|$),REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com(?::443)?\/ext\/smartch\/banner\/sch\/v\d+(?:\?|$),REJECT


# Other explicit LINE Ad APIs

URL-REGEX,^https:\/\/w\.line\.me(?::443)?\/adp\/api\/ad\/v\d+\//,REJECT
URL-REGEX,^https:\/\/sch\.line\.me(?::443)?\/api\/v\d+\/ads(?:\?|$),REJECT


# Existing FutaFilter LINE commerce / More tab rules

URL-REGEX,^https:\/\/buy\.line\.me(?::443)?\/api\/graphql\?variables,REJECT
URL-REGEX,^https:\/\/scdn\.line-apps\.com(?::443)?\/appresources\/moretab\/list\.json,REJECT


# ------------------------------------------------------------
# LINE advertising media
# ------------------------------------------------------------

# Dedicated Smart Channel advertising CDN.
# Domain-level rejection avoids MITM overhead.

DOMAIN,ad.line-scdn.net,REJECT


# Home / GEB promotional banner media

DOMAIN,ec-bot-obs.line-scdn.net,REJECT


# LINE Web / LIFF Ads SDK

URL-REGEX,^https:\/\/static\.line-scdn\.net(?::443)?\/ad-sdk\//,REJECT


# LINE Pay / LIFF campaign banner

URL-REGEX,^https:\/\/web-mmap-pay\.line-apps\.com(?::443)?\/tw\/liff\/campaign\/v\d+\/aggregate\/ad\/banner\//,REJECT


# Legacy LINE banner / event assets

URL-REGEX,^https:\/\/scdn\.line-apps\.com(?::443)?\/lan\/image\/line\/bannerImageEvent\//,REJECT
URL-REGEX,^https:\/\/scdn\.line-apps\.com(?::443)?\/lan\/document\/pageEvent\/line\/ios\//,REJECT


# ------------------------------------------------------------
# LINE telemetry / tracking / analytics / diagnostics
# ------------------------------------------------------------

# Generic LINE event tracking

URL-REGEX,^https:\/\/gw\.line\.naver\.jp(?::443)?\/tr\/event(?:\?|$),REJECT
URL-REGEX,^https:\/\/legy\.line-apps\.com(?::443)?\/tr\/event(?:\?|$),REJECT


# Recommendation / content impression collector

URL-REGEX,^https:\/\/crs-event\.line\.me(?::443)?\/v\d+\/imp(?:\?|$),REJECT


# UTS analytics collector

DOMAIN,uts-front.line-apps.com,REJECT


# UTS analytics JavaScript SDK

URL-REGEX,^https:\/\/static\.line-scdn\.net(?::443)?\/uts\//,REJECT


# NELO2 diagnostics / log collector

DOMAIN,nelo2-col.linecorp.com,REJECT


# CIX client information endpoint

URL-REGEX,^https:\/\/cix\.line-apps\.com(?::443)?\/R\d+(?:\?|$),REJECT


# ------------------------------------------------------------
# LINE News / TODAY
# ------------------------------------------------------------

URL-REGEX,^https:\/\/api\.today\.line\.me(?::443)?\/webapi\/TW\/recommendation\/articles\/articleend,REJECT



# ============================================================
# DCARD
# ============================================================

URL-REGEX,^https:\/\/bilanx\.dcard\.tw\/v\d+\/events$,REJECT
URL-REGEX,^https:\/\/bilanx\.dcard\.tw\/v\d+\/configs$,REJECT



# ============================================================
# 漫畫人 / 漫畫社
# ============================================================

# Public advertising / promotion APIs

URL-REGEX,^https?:\/\/(mangaapi|comicapi)\.(manhuaren|manhuashe)\.(com|net)\/.+\/public\/(getShelfActivity|getStartPageAds|getStartPageAds2|getRecommendedGame|getAditem|getAds|getMultiAds|getUpgradeInfo|getVendor|getUserLocation),REJECT


# Manga / comic promotion APIs

URL-REGEX,^https?:\/\/(mangaapi|comicapi)\.(manhuaren|manhuashe)\.(com|net)\/.+\/(manga|comic)\/(getMangaPromotionActivity|getComicPromotionActivity),REJECT


# Advertising endpoints

URL-REGEX,^https?:\/\/(mangaapi|comicapi)\.(manhuaren|manhuashe)\.(com|net)\/.+\/(ad|ads)\//,REJECT


# Advertising / logging domains

DOMAIN-SUFFIX,hkadsapi.manhuaren.com,REJECT
DOMAIN-SUFFIX,hkadsapi.manhuaren.net,REJECT
DOMAIN-SUFFIX,hkadsapi.manhuashe.com,REJECT
DOMAIN-SUFFIX,hkadsapi.manhuashe.net,REJECT

DOMAIN-SUFFIX,adsapi.manhuaren.com,REJECT
DOMAIN-SUFFIX,adsapi.manhuaren.net,REJECT
DOMAIN-SUFFIX,adsapi.manhuashe.com,REJECT
DOMAIN-SUFFIX,adsapi.manhuashe.net,REJECT

DOMAIN-SUFFIX,videoapi.manhuaren.com,REJECT
DOMAIN-SUFFIX,videoapi.manhuaren.net,REJECT
DOMAIN-SUFFIX,videoapi.manhuashe.com,REJECT
DOMAIN-SUFFIX,videoapi.manhuashe.net,REJECT

DOMAIN-SUFFIX,bi.manhuaren.com,REJECT
DOMAIN-SUFFIX,bi.manhuaren.net,REJECT
DOMAIN-SUFFIX,bi.manhuashe.com,REJECT
DOMAIN-SUFFIX,bi.manhuashe.net,REJECT

DOMAIN-SUFFIX,euadsapi.manhuaren.com,REJECT
DOMAIN-SUFFIX,euadsapi.manhuaren.net,REJECT
DOMAIN-SUFFIX,euadsapi.manhuashe.com,REJECT
DOMAIN-SUFFIX,euadsapi.manhuashe.net,REJECT

DOMAIN-SUFFIX,adlog.manhuaren.com,REJECT
DOMAIN-SUFFIX,adlog.manhuaren.net,REJECT
DOMAIN-SUFFIX,adlog.manhuashe.com,REJECT
DOMAIN-SUFFIX,adlog.manhuashe.net,REJECT

DOMAIN-SUFFIX,applog.uc.cn,REJECT-TINYGIF



# ============================================================
# 4GAMERS
# ============================================================

URL-REGEX,^https:\/\/www\.4gamers\.com\.tw\/site\/api\/aols\/media(?:\?|$),REJECT



# ============================================================
# PTT
# ============================================================

URL-REGEX,^https:\/\/pttbrain\.herokuapp\.com\/api\/ptt\/metric\/user-geo-distributions,REJECT



# ============================================================
# PIXNET
# ============================================================

URL-REGEX,^https:\/\/front\.pixfs\.net\/module\/idlePop\/js\//,REJECT



# ============================================================
# POKE GENIE
# ============================================================

DOMAIN-SUFFIX,cloudfunctions.net,DIRECT
DOMAIN-SUFFIX,admob-app-id-4587251595.firebaseio.com,DIRECT



